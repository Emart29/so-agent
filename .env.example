# Groq is the default provider. Free tier, no payment method required.
# Key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Used for one benchmark slice comparing the same model across
# different serving stacks. Free tier is roughly 50 requests/day, so this
# provider is budget-guarded and never selected implicitly.
# Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model ids are discovered and measured by the capability probe rather than
# guessed. Leave these empty until it has run.
PRIMARY_MODEL=
CRITIC_MODEL=
FALLBACK_MODEL=
